        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(batcher_inference_batches_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "batches/s",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(batcher_inference_blocked_ms_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / 1000",
          "legendFormat": "workers blocked on input",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(batcher_inference_latency_ms_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(batcher_inference_batches_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "mean batch latency (ms)",
          "range": true,
          "refId": "D"
