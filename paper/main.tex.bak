\section{\kyber{}: an optimizer that learns}
\label{sec:kyber}
% ===========================================================================

\begin{figure}[t]
\centering
\begin{tikzpicture}[x=1mm,y=1mm]
  % --- phase pipeline -----------------------------------------------------
  \foreach \i/\n in {0/NORMALIZE, 1/REWRITE, 2/PUSHDOWN,
                     3/JOIN ORDER, 4/FUSION, 5/SELECTION, 6/ENFORCE} {
    \node[pfig/box, minimum width=21mm, minimum height=5mm, font=\scriptsize,
