\texttt{groupby-2key}    & \win 0.62 & \win 0.40 & \win 0.54 & \win 0.22 \\
\texttt{global-sum}      & \win 0.04 & \win 0.06 & \win 0.04 & \win 0.02 \\
\texttt{filter-count}    & \win 0.07 & \win 0.03 & \win 0.00 & \win 0.03 \\
\texttt{join-agg}        & \loss 1.25 & \loss 1.18 & \win 0.32 & \win 0.46 \\
\texttt{sort-limit}      & \loss 1.09 & \win 0.02 & \win 0.01 & \win 0.10 \\
\texttt{filter-project}  & \win 0.79 & \loss 1.10 & \win 0.06 & \win 0.49 \\
\texttt{window-rank}     & \win 0.84 & \win 0.12 & --- & hangs \\
\texttt{window-runsum}   & \win 0.50 & \win 0.15 & --- & hangs \\
\texttt{window-lag}      & \win 0.71 & \win 0.04 & --- & hangs \\
\texttt{window-sum-part} & \win 0.64 & \win 0.85 & --- & hangs \\
