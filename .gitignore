# Rust
/target
# Scratch cargo target dirs used to reproduce a failure at HEAD without
# clobbering the shared ./target (see .claude/rules/concurrent-agents.md).
# Globbed, not listed: a `git add -A` once staged 5,125 files out of one of these.
/target-*
**/*.rs.bk
# Cargo.lock IS committed: the engine ships as a wheel and we want reproducible builds.

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
build/
*.so
.coverage
.coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Built documentation site
docs/_build/
# autosummary-generated API stubs (regenerated on every build)
docs/api/generated/
docs/api/**/generated/
# Intermediate Graphviz sources (generated by docs/_static/diagrams/render.py;
# the rendered .png files are committed).
docs/_static/diagrams/*.dot

# Local benchmark env helper (Rust toolchain + venv activation)
.envrc.bench

# Local working notes, one-off comparison scripts, and their output
scratchpad/

# Python packaging output. Anchored: a bare `dist/` also matches the source package
# `python/batcher/dist/`, which silently swallowed a new module there on `git add`.
/dist/
wt-build.sh
